G {}
K {type=primitive
verilog_ignore=true
vhdl_ignore=true
format="@name [ @@clk @@rst_n ] [ @@q0 @@q1 @@q2 @@q3 ] @model
.model @model d_cosim simulation=./counter4_behav.so"
template="name=adut
model=dut"
}
V {}
S {}
E {}
L 4 -140 -10 -120 -10 {}
L 4 -140 10 -120 10 {}
L 4 120 -30 140 -30 {}
L 4 120 -10 140 -10 {}
L 4 120 10 140 10 {}
L 4 120 30 140 30 {}
L 4 -120 -50 -120 50 {}
L 4  120 -50  120 50 {}
L 4 -120 -50  120 -50 {}
L 4 -120  50  120  50 {}
B 5 -142.5 -12.5 -137.5 -7.5 {name=clk dir=in verilog_type=wire propag=0}
B 5 -142.5 7.5 -137.5 12.5 {name=rst_n dir=in verilog_type=wire propag=0}
B 5 137.5 -32.5 142.5 -27.5 {name=q0 dir=out verilog_type=wire propag=1}
B 5 137.5 -12.5 142.5 -7.5 {name=q1 dir=out verilog_type=wire propag=1}
B 5 137.5 7.5 142.5 12.5 {name=q2 dir=out verilog_type=wire propag=1}
B 5 137.5 27.5 142.5 32.5 {name=q3 dir=out verilog_type=wire propag=1}
T {counter4} 0 0 0 0 0.3 0.3 {hcenter=true vcenter=true}
T {@name}  -120 -68 0 0 0.2 0.2 {}
T {d_cosim} -120 -56  0 0 0.15 0.15 {layer=4}
T {clk} -108 -14 0 0 0.15 0.15 {}
T {rst_n} -108 6 0 0 0.15 0.15 {}
T {q0} 108 -34 0 1 0.15 0.15 {}
T {q1} 108 -14 0 1 0.15 0.15 {}
T {q2} 108 6 0 1 0.15 0.15 {}
T {q3} 108 26 0 1 0.15 0.15 {}
